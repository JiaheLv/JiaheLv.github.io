---
import HomePageLayout from '@layouts/HomePageLayout.astro';
import ArticleListItem from '@components/ArticleListItem.astro';
import { getCollection } from 'astro:content';
import { getSiteConfig } from '@utils/config';
import { getLink } from '@utils/paths';

// Get all blog posts
const allPosts = await getCollection('blogs', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort posts by date in descending order (newest first)
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Filter posts by the 5 category groups
const notesPosts = sortedPosts.filter(post =>
  post.data.categories?.includes('笔记')
);
const projectPosts = sortedPosts.filter(post =>
  post.data.categories?.includes('项目')
);
const miscPosts = sortedPosts.filter(post =>
  post.data.categories?.includes('杂记')
);
const essaysPosts = sortedPosts.filter(post =>
  post.data.categories?.includes('札记')
);
const casualPosts = sortedPosts.filter(post =>
  post.data.categories?.includes('随笔')
);

// Get site configuration
const siteConfig = getSiteConfig();

const sectionClass = 'flex min-h-0 flex-1 flex-col';
const headingClass = 'mb-[10px] mt-0 border-b-2 border-[rgba(0,0,0,0.9)] p-0 pb-[5px] text-2xl font-semibold';
const categoryClass = 'text-black hover:text-black';
const listClass = 'm-0 min-h-0 flex-1 list-none overflow-y-auto overflow-x-hidden p-0 [scrollbar-width:none] [touch-action:pan-y] [&::-webkit-scrollbar]:hidden';
const emptyClass = 'm-0 px-[10px] py-0 text-[1.2rem] font-medium italic text-[rgba(0,0,0,0.75)]';
---

<HomePageLayout title={`${siteConfig.title}`}>
  <!-- 笔记 -->
  <fragment slot="notes" class={sectionClass}>
    <h2 class={headingClass}><a href={getLink('/categories/笔记')} title="查看全部" class={categoryClass}>笔记</a></h2>
    {notesPosts.length > 0 ? (
      <ul class={listClass}>
        {notesPosts.map(post => (
          <ArticleListItem
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
            tags={post.data.tags}
            author={post.data.author}
            location={post.data.location}
            slug={post.slug}
          />
        ))}
      </ul>
    ) : (
      <p class={emptyClass}>暂无笔记内容</p>
    )}
  </fragment>

  <!-- 项目 -->
  <fragment slot="projects" class={sectionClass}>
    <h2 class={headingClass}><a href={getLink('/categories/项目')} title="查看全部" class={categoryClass}>项目</a></h2>
    {projectPosts.length > 0 ? (
      <ul class={listClass}>
        {projectPosts.map(post => (
          <ArticleListItem
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
            tags={post.data.tags}
            author={post.data.author}
            location={post.data.location}
            slug={post.slug}
          />
        ))}
      </ul>
    ) : (
      <p class={emptyClass}>暂无项目内容</p>
    )}
  </fragment>

  <!-- 杂记 -->
  <fragment slot="misc" class={sectionClass}>
    <h2 class={headingClass}><a href={getLink('/categories/杂记')} title="查看全部" class={categoryClass}>杂记</a></h2>
    {miscPosts.length > 0 ? (
      <ul class={listClass}>
        {miscPosts.map(post => (
          <ArticleListItem
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
            tags={post.data.tags}
            author={post.data.author}
            location={post.data.location}
            slug={post.slug}
          />
        ))}
      </ul>
    ) : (
      <p class={emptyClass}>暂无杂记内容</p>
    )}
  </fragment>

  <!-- 札记 -->
  <fragment slot="essays" class={sectionClass}>
    <h2 class={headingClass}><a href={getLink('/categories/札记')} title="查看全部" class={categoryClass}>札记</a></h2>
    {essaysPosts.length > 0 ? (
      <ul class={listClass}>
        {essaysPosts.map(post => (
          <ArticleListItem
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
            tags={post.data.tags}
            author={post.data.author}
            location={post.data.location}
            slug={post.slug}
          />
        ))}
      </ul>
    ) : (
      <p class={emptyClass}>暂无札记内容</p>
    )}
  </fragment>

  <!-- 随笔 -->
  <fragment slot="casual" class={sectionClass}>
    <h2 class={headingClass}><a href={getLink('/categories/随笔')} title="查看全部" class={categoryClass}>随笔</a></h2>
    {casualPosts.length > 0 ? (
      <ul class={listClass}>
        {casualPosts.map(post => (
          <ArticleListItem
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
            tags={post.data.tags}
            author={post.data.author}
            location={post.data.location}
            slug={post.slug}
          />
        ))}
      </ul>
    ) : (
      <p class={emptyClass}>暂无随笔内容</p>
    )}
  </fragment>
</HomePageLayout>
