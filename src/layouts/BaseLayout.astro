---
import { SEO } from 'astro-seo';
import '../styles/global.css';
import { getSiteConfig, getSeoConfig } from '@utils/config';
import { getLink } from '@utils/paths';
import Breadcrumb from '@components/Breadcrumb.astro';
import UptoTop from '@components/UptoTop.astro';
import logoSvg from '../assets/icons/Jiahe-Lv-s-Archive.svg?raw';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
  bodyClass?: string;
}

// Get site configuration
const siteConfig = getSiteConfig();
const seoConfig = getSeoConfig();

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/images/default-social.png',
  article = false,
  pubDate,
  updatedDate,
  tags,
  category,
  bodyClass = 'min-h-screen m-[1%] box-border bg-white px-[1%] py-0 font-sans text-slate-900 antialiased'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteConfig.url);
const logoMarkup = logoSvg.replace('<svg', '<svg class="h-auto w-full"');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href={getLink("/favicon.svg")} />
    <!-- Fallback for browsers that do not use SVG favicons. -->
    <link rel="icon" type="image/x-icon" href={getLink("/favicon.ico")} sizes="48x48" />
    <link rel="apple-touch-icon" href={getLink("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content={siteConfig.author} />
    <meta property="og:locale" content="zh_CN" />

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title: title,
          type: article ? 'article' : 'website',
          image: image.startsWith('http') ? image : new URL(image, Astro.site).toString()
        },
        optional: {
          description: description,
          siteName: siteConfig.title,
        },
        article: article ? {
          authors: [siteConfig.author],
          publishedTime: pubDate?.toISOString(),
          modifiedTime: updatedDate?.toISOString(),
          tags: tags,
          section: category,
        } : undefined
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: image.startsWith('http') ? image : new URL(image, Astro.site).toString(),
        creator: seoConfig.openGraph.twitterCreator
      }}
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org/",
      "@type": "WebSite",
      "name": siteConfig.title,
      "url": siteConfig.url,
      "author": {
        "@type": "Person",
        "name": siteConfig.author
      }
    })} />

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <div class="mx-auto mt-[0.5%] flex w-[38%] items-center justify-center">
      <a href={getLink('/')} title="首页" class="block w-full text-black hover:text-black">
        <Fragment set:html={logoMarkup} />
      </a>
    </div>
    <Breadcrumb currentTitle={title} />
    <slot />
    <UptoTop />
  </body>
</html>
