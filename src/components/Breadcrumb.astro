---
import { isFeatureEnabled } from '@utils/config';
import { getLink } from '@utils/paths';

const isBreadcrumbEnabled = isFeatureEnabled('breadcrumb');

interface Props {
  currentTitle?: string;
}

interface BreadcrumbItem {
  label: string;
  href: string;
}

const { currentTitle } = Astro.props;

const routeLabels: Record<string, string> = {
  blogs: '博客',
  categories: '分类',
  tags: '标签',
  search: '搜索',
  about: '关于',
};

const decodeSegment = (segment: string): string => {
  try {
    return decodeURIComponent(segment);
  } catch {
    return segment;
  }
};

const formatSegment = (segment: string): string => {
  const decoded = decodeSegment(segment);
  if (routeLabels[decoded]) return routeLabels[decoded];

  return decoded
    .split(/[-_]/)
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
};

const normalizeTitle = (title?: string): string | undefined => {
  const trimmed = title?.trim();
  if (!trimmed) return undefined;

  return trimmed.split('|')[0]?.trim() || trimmed;
};

const buildBreadcrumbs = (): BreadcrumbItem[] => {
  const basePath = import.meta.env.BASE_URL || '/';
  const normalizedBasePath =
    basePath.length > 1 && basePath.endsWith('/') ? basePath.slice(0, -1) : basePath;

  let routePath = Astro.url.pathname;
  if (
    normalizedBasePath &&
    normalizedBasePath !== '/' &&
    routePath.startsWith(normalizedBasePath)
  ) {
    routePath = routePath.slice(normalizedBasePath.length) || '/';
  }

  if (!routePath.startsWith('/')) routePath = `/${routePath}`;
  if (routePath.length > 1 && routePath.endsWith('/')) routePath = routePath.slice(0, -1);

  const segments = routePath.split('/').filter(Boolean);
  const items: BreadcrumbItem[] = [{ label: '首页', href: getLink('/') }];
  const titleLabel = normalizeTitle(currentTitle);

  let accumulatedPath = '';
  segments.forEach((segment, index) => {
    accumulatedPath += `/${segment}`;
    const isLast = index === segments.length - 1;

    items.push({
      label: isLast && titleLabel ? titleLabel : formatSegment(segment),
      href: getLink(accumulatedPath),
    });
  });

  return items;
};

const breadcrumbs = isBreadcrumbEnabled ? buildBreadcrumbs() : [];
---

{
  breadcrumbs.length > 1 && (
    <nav
      aria-label="面包屑导航"
      class="py-2 text-lg text-center flex flex-wrap items-center justify-center gap-1"
    >
      <span>当前位置：</span>
      <ol class="flex flex-wrap items-center list-none m-0 p-0 gap-1">
        {breadcrumbs.map((item, index) => {
          const isLast = index === breadcrumbs.length - 1;

          return (
            <li class="inline-flex items-center gap-1">
              {index > 0 && (
                <span class="inline-flex items-center text-black" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="black"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </span>
              )}
              {isLast ? (
                <span class="text-black font-medium" aria-current="page">
                  {item.label}
                </span>
              ) : (
                <a
                  href={item.href}
                  class="text-black font-bold underline hover:text-black hover:underline transition-colors"
                  title={item.label}
                >
                  {item.label}
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}
