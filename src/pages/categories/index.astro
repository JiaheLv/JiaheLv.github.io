---
import { getCollection } from 'astro:content';
import CategoryPageLayout from '@layouts/OtherPageLayout.astro';
import { getLink } from '@utils/paths';

// Get all blog posts
const allPosts = await getCollection('blogs', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Extract and count categories
const categoryCount = allPosts.reduce((acc, post) => {
  if (post.data.categories) {
    post.data.categories.forEach(category => {
      acc[category] = (acc[category] || 0) + 1;
    });
  }
  return acc;
}, {} as Record<string, number>);

// Convert to array and sort by count (descending)
const categories = Object.entries(categoryCount)
  .sort(([, a], [, b]) => b - a)
  .map(([name, count]) => ({ name, count }));
---

<CategoryPageLayout title="Categories | Modern Blog">
  <header class="pb-8 border-b border-slate-200 mb-8">
    <h1 class="text-4xl font-bold mb-4">Categories</h1>
    <p class="text-lg text-slate-600">
      Browse blog posts by category
    </p>
  </header>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:gap-6">
    {categories.map(({ name, count }) => (
      <a 
        href={getLink(`/categories/${name.toLowerCase().replace(/\s+/g, '-')}`)}
        class="flex min-w-0 flex-col items-center rounded-lg border border-slate-200 bg-white p-4 text-center transition-shadow hover:shadow-md sm:p-6"
      >
        <h2 class="text-xl font-bold mb-2">{name}</h2>
        <p class="text-slate-500">
          {count} post{count !== 1 ? 's' : ''}
        </p>
      </a>
    ))}
  </div>

  {categories.length === 0 && (
    <div class="text-center py-12">
      <p class="text-xl text-slate-600">No categories found.</p>
    </div>
  )}
</CategoryPageLayout>
