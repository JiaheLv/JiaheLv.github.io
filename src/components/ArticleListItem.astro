---
import { getLink } from '@utils/paths';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  location?: string;
  slug: string;
}

const { title, slug } = Astro.props;
---

<article>
  <!-- Content column -->
  <a
    href={getLink(`/blogs/${slug}`)}
    class="mb-[10px] mx-[3px] block rounded-lg border-2 border-solid border-[rgba(0,0,0,0.2)] p-[5px] text-black no-underline hover:scale-[1.01] hover:bg-[rgba(255,255,255,0.3)] hover:text-black"
    title={title}
  >
    <!-- Title -->
    <h3 class="m-0 overflow-hidden text-ellipsis whitespace-nowrap p-0 text-[1.3rem] font-[550]">
      {title}
    </h3>
      <!-- Tags -->
      <!-- {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mb-3">
          {tags.map(tag => (
            <a 
              href={getLink(`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`)}
              class="text-xs text-slate-500 hover:text-indigo-600"
            >
              #{tag}
            </a>
          ))}
        </div>
      )} -->
      
      <!-- Description -->
      <!-- <p class="text-slate-600 mb-3 text-sm">
        {description}
      </p> -->
      
      <!-- Footer -->
      <!-- <div class="flex items-center justify-between text-xs">
        <span class="text-slate-500">
          {author && `By ${author}`} {location && `at ${location}`}
        </span>
        
        <a 
          href={getLink(`/blogs/${slug}`)}
          class="text-indigo-600 hover:underline"
        >
          Read more →
        </a>
      </div> -->
  </a>
</article>
