---
import BaseLayout from './BaseLayout.astro';
import Icon from '@components/Icon.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const { title, description, image, article } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  article={article}
  bodyClass="m-0 flex h-[100dvh] flex-col overflow-hidden bg-white p-0 font-sans text-slate-900 antialiased"
>
  <!-- Main Content -->
  <div class="mx-auto mt-[10px] grid h-auto min-h-0 w-[94%] flex-1 grid-cols-[2.2fr_7.8fr] grid-rows-[5.8fr_4.2fr] gap-[10px] p-0">
    <!-- <header class="pb-8 border-b border-slate-200 mb-8">
      <slot name="hero" />
    </header> -->

    <!-- 笔记 -->
    <section class="col-start-1 row-span-2 row-start-1 flex flex-col overflow-hidden rounded-[10px] border-[3px] border-solid border-black p-[10px] shadow-[0_4px_15px_rgba(0,0,0,0.1)] transition hover:scale-[1.01] hover:bg-[rgba(255,191,112,0.3)] hover:shadow-[5px_5px_10px_rgba(0,0,0,0.8)]">
      <slot name="notes" />
    </section>
    <div class="grid grid-cols-[1.5fr_1fr]">
      <!-- 项目 -->
      <section class="col-start-1 row-start-1 mr-[5px] flex flex-col overflow-hidden rounded-[10px] border-[3px] border-solid border-black p-[10px] shadow-[0_4px_15px_rgba(0,0,0,0.1)] transition hover:scale-[1.01] hover:bg-[rgba(255,191,112,0.3)] hover:shadow-[5px_5px_10px_rgba(0,0,0,0.8)]">
        <slot name="projects" />
      </section>

      <!-- 札记 -->
      <section class="col-start-2 row-start-1 ml-[5px] flex flex-col overflow-hidden rounded-[10px] border-[3px] border-solid border-black p-[10px] shadow-[0_4px_15px_rgba(0,0,0,0.1)] transition hover:scale-[1.01] hover:bg-[rgba(255,191,112,0.3)] hover:shadow-[5px_5px_10px_rgba(0,0,0,0.8)]">
        <slot name="essays" />
      </section>
    </div>
    <div class="grid grid-cols-2">
      <!-- 杂记 -->
      <section class="col-start-1 row-start-1 mr-[5px] flex flex-col overflow-hidden rounded-[10px] border-[3px] border-solid border-black p-[10px] shadow-[0_4px_15px_rgba(0,0,0,0.1)] transition hover:scale-[1.01] hover:bg-[rgba(255,191,112,0.3)] hover:shadow-[5px_5px_10px_rgba(0,0,0,0.8)]">
        <slot name="misc" />
      </section>

      <!-- 随笔 -->
      <section class="col-start-2 row-start-1 ml-[5px] flex flex-col overflow-hidden rounded-[10px] border-[3px] border-solid border-black p-[10px] shadow-[0_4px_15px_rgba(0,0,0,0.1)] transition hover:scale-[1.01] hover:bg-[rgba(255,191,112,0.3)] hover:shadow-[5px_5px_10px_rgba(0,0,0,0.8)]">
        <slot name="casual" />
      </section>
    </div>
  </div>
  <div class="relative mx-auto mb-[5px] mt-[10px] flex h-max w-max items-center gap-[5px] p-0">
    <a href="https://github.com/JiaheLv/JiaheLv.github.io" class="flex items-center text-black no-underline hover:scale-[1.05] hover:text-black" title="Github Link" target="_blank">
      <Icon name="github" class="github_icon" size={29} />
    </a>
    <button class="m-0 flex h-[26px] items-center justify-center rounded-[1em] border-[3px] border-solid border-black bg-[rgba(255,255,255,0.1)] px-[5px] py-0 text-base font-bold hover:scale-[1.05] hover:bg-[rgba(255,255,255,0.2)] hover:shadow-[0_0_5px_rgba(0,0,0,0.5)]" title="About me"><a href="/about" class="no-underline text-black hover:text-black">About me</a></button>
  </div>
</BaseLayout>
