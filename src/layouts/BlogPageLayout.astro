---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Sidebar from '@components/Sidebar.astro';
import MobileNav from '@components/MobileNav.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  toc?: {
    depth: number;
    slug: string;
    text: string;
  }[];
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
}

const { title, description, image, article, toc, pubDate, updatedDate, tags, category } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} article={article} pubDate={pubDate} updatedDate={updatedDate} tags={tags} category={category}>
  <div class="m-[10px] flex flex-row items-start justify-center">
    <!-- Mobile Navigation (shown only on small screens) -->
    <MobileNav />

    {toc && toc.length > 0 && (
      <div class="mt-[80px] max-h-[80vh] w-[15%] shrink-0 self-start overflow-y-hidden sticky top-[12%]">
        <TableOfContents headings={toc} />
      </div>
    )}

    <!-- Main Content -->
    <main class="mx-[10px] my-[10px] w-[55%] shrink-0 rounded-[0.6em] border border-slate-200 bg-[rgba(255,228,196,0.4)] px-[20px] py-[15px]">
      <div>
        <slot />
      </div>
    </main>

    <!-- Right Sidebar -->
    <div class="mt-[80px] w-[15%] shrink-0 self-start sticky top-[15%]">
      <Sidebar />
    </div>
  </div>
</BaseLayout>
