---
import { getLink } from '@utils/paths';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  location?: string;
  slug: string;
}

const { title, pubDate, updatedDate, slug } = Astro.props;


const hasUpdated = updatedDate && updatedDate > pubDate;

var formattedDateStr = `创建于 ${new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
  formatter: 'short'
}).format(pubDate)}`;

// Change date format to single line compact format
if (hasUpdated) {
  formattedDateStr = `更新于 ${new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
    formatter: 'short'
  }).format(updatedDate)}`;
}
---

<article>
  <!-- Content column -->
  <a href={getLink(`/blogs/${slug}`)} class="article_link" title={title}>
    <!-- Title -->
    <h3 class="article_title">
      {title}
    </h3>
    <!-- Date -->
    <!-- <div class="article_date">
      {formattedDateStr}
    </div> -->
      <!-- Tags -->
      <!-- {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mb-3">
          {tags.map(tag => (
            <a 
              href={getLink(`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`)}
              class="text-xs text-slate-500 hover:text-indigo-600"
            >
              #{tag}
            </a>
          ))}
        </div>
      )} -->
      
      <!-- Description -->
      <!-- <p class="text-slate-600 mb-3 text-sm">
        {description}
      </p> -->
      
      <!-- Footer -->
      <!-- <div class="flex items-center justify-between text-xs">
        <span class="text-slate-500">
          {author && `By ${author}`} {location && `at ${location}`}
        </span>
        
        <a 
          href={getLink(`/blogs/${slug}`)}
          class="text-indigo-600 hover:underline"
        >
          Read more →
        </a>
      </div> -->
  </a>
</article>

<style>
  .article_link {
    display: block;
    border-radius: 8px;
    border: 2px solid rgba(0, 0, 0, 0.2);
    margin: 0 3px 10px;
    padding: 5px;
    text-decoration: none;
    color: black;
  }
  .article_link:hover {
    background-color: rgba(255, 255, 255, 0.3);
    transform: scale(1.01);
  }
  .article_title {
    font-size: 1.3rem;
    font-weight: 550;
    margin: 0;
    padding: 0;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .article_title a {
    color: black;
    text-decoration: none;
  }
</style>