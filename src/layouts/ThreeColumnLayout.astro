---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Sidebar from '@components/Sidebar.astro';
import MobileNav from '@components/MobileNav.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  toc?: {
    depth: number;
    slug: string;
    text: string;
  }[];
}

const { title, description, image, article, toc } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} article={article}>
  <div class="layout">
    <!-- Mobile Navigation (shown only on small screens) -->
    <MobileNav />

    {toc && toc.length > 0 && (
      <div class="toc-column">
        <TableOfContents headings={toc} />
      </div>
    )}

    <!-- Main Content -->
    <main>
      <div>
        <slot />
      </div>
    </main>

    <!-- Right Sidebar -->
    <div class="sidebar-column">
      <Sidebar />
    </div>
  </div>
</BaseLayout>

<style>
  .layout {
    margin: 10px;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
  }

  .toc-column {
    width: 15%;
    flex-shrink: 0;
    margin-top: 80px;
    position: sticky;
    top: 12%;
    align-self: flex-start;
    max-height: 80vh;
    overflow-y: hidden;
  }

  main {
    width: 55%;
    flex-shrink: 0;
    margin: 10px 10px;
    padding: 15px 20px;
    /* border: 2px red dashed; */
    background-color: rgba(255, 228, 196, 0.4);
    border-radius: 0.6em;
    border: 1px solid rgb(226 232 240 / var(--tw-border-opacity, 1));
  }

  .sidebar-column {
    width: 15%;
    flex-shrink: 0;
    margin-top: 80px;
    position: sticky;
    top: 15%;
    align-self: flex-start;
  }
</style>